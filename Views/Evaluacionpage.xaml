<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyect.ViewModels"
             x:Class="Proyect.Views.EvaluacionPage"
             Title="Evaluación de Temas"
             BackgroundColor="#F3F3F3">

    <ContentPage.BindingContext>
        <vm:EvaluacionViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*, Auto" RowSpacing="15" Padding="20">

        
        <CollectionView Grid.Row="0" 
                          ItemsSource="{Binding Preguntas}"
                          SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" 
                           CornerRadius="12" 
                           HasShadow="True" 
                           Margin="0,0,0,15" 
                           Padding="15">

                        <VerticalStackLayout Spacing="10">

                           
                            <Label Text="{Binding Enunciado}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#333333" />

                            
                            <Picker Title="Toca aquí para elegir tu respuesta"
                                    ItemsSource="{Binding Opciones}"
                                    SelectedIndex="{Binding IndiceSeleccionado}" 
                                    TextColor="green"
                                    TitleColor="Gray"
                                    FontSize="14" />

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        
        <Button Grid.Row="1"
                Text="Terminar y Evaluar Examen"
                Command="{Binding FinalizarEvaluacionCommand}"
                BackgroundColor="green"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="55"
                CornerRadius="10" />

    </Grid>
</ContentPage>