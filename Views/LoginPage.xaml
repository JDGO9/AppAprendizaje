<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Proyect.ViewModels"
             x:Class="Proyect.Views.LoginPage"
             Title="Iniciar Sesión"
             BackgroundColor="White">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Start" MaximumWidthRequest="400">
        <Image Source="logoelectroedu.png" 
        HeightRequest="200" 
        HorizontalOptions="Center" 
        Margin="0,10,0,10"/> 
        
        <Label Text="¡Bienvenido!" 
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="Green" />

        <Entry Placeholder="Correo electrónico"
               Text="{Binding Email}"
               Keyboard="Email"
               HeightRequest="50" />

        <Entry Placeholder="Contraseña"
               Text="{Binding Password}"
               IsPassword="True"
               HeightRequest="50" />

        <Button Text="Iniciar Sesión"
                Command="{Binding LoginCommand}"
                BackgroundColor="Green"
                TextColor="White"
                HeightRequest="50" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}" 
                           Color="GREEN" 
                           HorizontalOptions="Center" />

        
        <Button Text="¿No tienes cuenta? Regístrate aquí"
                Command="{Binding GoToRegisterCommand}"
                BackgroundColor="Transparent"
                TextColor="Green"
                HeightRequest="50"
                FontSize="14" />

    </VerticalStackLayout>
</ContentPage>